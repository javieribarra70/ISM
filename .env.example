# ============================================================================
# CONFIGURACIÓN DE DESARROLLO LOCAL — Sistema FISM
# ============================================================================
# Copia este archivo como .env (sin sufijo) y ajusta los valores según
# necesites. El archivo .env NO se sube a git (está en .gitignore).
# ============================================================================

# ----------------------------------------------------------------------------
# BASE DE DATOS LOCAL (Postgres en Docker)
# ----------------------------------------------------------------------------
# Connection string que tanto el frontend (Express + Drizzle) como el
# backend Python van a usar. Coincide con la configuración del docker-compose.
# Nota: usamos puerto 5433 en lugar de 5432 porque 5432 puede estar
# ocupado por una instalación nativa de Postgres en Windows.
DATABASE_URL=postgresql://fism_user:fism_dev_password@localhost:5433/fism_db

# Password de Postgres usado en docker-compose. Cambiar en producción.
POSTGRES_PASSWORD=fism_dev_password

# ----------------------------------------------------------------------------
# SESIONES Y AUTENTICACIÓN DEL FRONTEND
# ----------------------------------------------------------------------------
# Secreto para firmar cookies de sesión Express. En desarrollo usa cualquier
# string largo; en producción debe ser único y no compartido.
SESSION_SECRET=cambiar_en_produccion_string_largo_aleatorio

# Modo de Node. Usa 'development' para desarrollo local, 'production' para deploy.
NODE_ENV=development

# ----------------------------------------------------------------------------
# OPENAI (opcional, usado actualmente por el frontend para clustering de ideas)
# ----------------------------------------------------------------------------
# Si no la defines, el frontend hace fallback a un método sin LLM.
OPENAI_API_KEY=

# ----------------------------------------------------------------------------
# API KEYS DEL SISTEMA FISM (se irán llenando en próximas etapas)
# ----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# DEEPSEEK_API_KEY=
# TOGETHER_API_KEY=
# VOYAGE_API_KEY=
# ZEP_API_KEY=
